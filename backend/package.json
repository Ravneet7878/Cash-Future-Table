{
  "name": "@cash-future/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../.env src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "express": "5.1.0",
    "pg": "8.16.3",
    "pino": "9.9.5",
    "pino-http": "10.5.0",
    "ws": "8.21.3",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@types/express": "5.0.3",
    "@types/node": "22.18.1",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "@types/ws": "8.18.1",
    "eslint": "9.35.0",
    "supertest": "7.1.4",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
